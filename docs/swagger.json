                "4-7"
            ],
            "x-enum-varnames": [
                "ShippingDays1to2",
                "ShippingDays2to3",
                "ShippingDays4to7"
            ]
        },
        "entity.ShippingPayer": {
            "type": "string",
            "enum": [
